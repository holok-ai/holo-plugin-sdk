#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run lint-staged for incremental checking of modified files
npx lint-staged

# If lint-staged fails, provide helpful message
if [ $? -ne 0 ]; then
  echo ""
  echo "⚠️  Pre-commit checks failed!"
  echo ""
  echo "To fix issues automatically (where possible):"
  echo "  npm run lint:fix"
  echo ""
  echo "To bypass hooks in an emergency (use sparingly):"
  echo "  git commit --no-verify -m \"your message\""
  echo "  ⚠️  Note: Bypassing requires justification in the commit message"
  echo ""
  exit 1
fi

# Run unit tests (fast tests only, not integration)
echo "Running unit tests..."
npm test -w app -- --testPathIgnorePatterns=integration --testPathIgnorePatterns=baseline

if [ $? -ne 0 ]; then
  echo ""
  echo "⚠️  Unit tests failed!"
  echo ""
  echo "Please fix failing tests before committing."
  echo ""
  echo "To run tests locally:"
  echo "  npm test"
  echo ""
  echo "To bypass hooks in an emergency (use sparingly):"
  echo "  git commit --no-verify -m \"your message\""
  echo "  ⚠️  Note: Bypassing requires justification in the commit message"
  echo ""
  exit 1
fi

echo "✅ All pre-commit checks passed!"