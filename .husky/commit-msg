#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run commitlint on the commit message
npx --no -- commitlint --edit "$1"

if [ $? -ne 0 ]; then
  echo ""
  echo "⚠️  Commit message validation failed!"
  echo ""
  echo "Your commit message must follow the Conventional Commits format:"
  echo "  type(scope): subject"
  echo ""
  echo "Valid types: feat, fix, docs, style, refactor, perf, test, chore, revert, wip"
  echo "Note: 'wip' is only allowed on feature branches, not in final squash commits"
  echo ""
  echo "Examples:"
  echo "  feat(common): add plugin discovery service"
  echo "  fix(workers): handle null provider config gracefully"
  echo "  docs: update README with setup instructions"
  echo ""
  echo "For detailed standards, see: docs/git-hygiene-standards.md"
  echo ""
  echo "To use the commit message template:"
  echo "  git config commit.template .gitmessage"
  echo ""
  echo "To bypass in an emergency (use sparingly):"
  echo "  git commit --no-verify -m \"your message\""
  echo "  ⚠️  Note: Bypassing requires justification"
  echo ""
  exit 1
fi