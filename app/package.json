{
  "name": "holo",
  "version": "1.2.0",
  "private": true,
  "description": "Holokai Holo",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "start": "node --import ./scripts/register-ts-node.mjs src/app.ts",
    "start-worker": "node --import ./scripts/register-ts-node.mjs src/servers/worker.server.ts",
    "start-audit": "node --import ./scripts/register-ts-node.mjs src/servers/audit.server.ts",
    "start-analysis": "node --import ./scripts/register-ts-node.mjs src/servers/analysis.server.ts",
    "dev": "nodemon src/app.js",
    "api:dev": "nodemon --exec \"node --import ./scripts/register-ts-node.mjs\" src/app.ts",
    "worker:dev": "nodemon --exec \"node --import ./scripts/register-ts-node.mjs\" src/servers/worker.server.ts",
    "audit:dev": "nodemon --exec \"node --import ./scripts/register-ts-node.mjs\" src/servers/audit.server.ts",
    "analysis:dev": "nodemon --exec \"node --import ./scripts/register-ts-node.mjs\" src/servers/analysis.server.ts",
    "test": "jest --config=./jest.config.cjs",
    "test:unit": "jest --config=./jest.config.cjs tests/unit --testTimeout=10000",
    "test:integration": "jest --config=./jest.config.cjs tests/integration --testTimeout=30000 --runInBand",
    "build": "tsc --build",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "amqplib": "^0.10.9",
    "arktype": "^2.1.22",
    "azure-devops-node-api": "^15.1.1",
    "body-parser": "^1.20.2",
    "diff": "^8.0.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-jwt": "^8.5.1",
    "express-list-endpoints": "^7.1.1",
    "fs-extra": "^11.3.2",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "uuid": "^9.0.1",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.3",
    "@types/express-list-endpoints": "^6.0.3",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.0.11",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT"
}
