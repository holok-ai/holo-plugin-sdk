FROM node:18-alpine

WORKDIR /app

# Copy tsconfig files (app/tsconfig.json extends ../tsconfig.json)
COPY tsconfig.json /tsconfig.json
COPY app/tsconfig.json /app/tsconfig.json

# Copy package files
COPY app/package*.json /app/

# Install PostgreSQL client
RUN apk --no-cache add postgresql-client

# Install all dependencies (including TypeScript and ts-node)
RUN npm install

# Copy source code
COPY app/src/ ./src/

# Create logs directory and set permissions
RUN mkdir -p /app/logs \
    && chmod 777 /app/logs

# Use non-root user for better security
USER node

# Set environment variables
ENV NODE_ENV=production

# Run the audit server with ts-node (TypeScript runtime)
CMD ["npx", "ts-node", "src/servers/audit.server.ts"]
