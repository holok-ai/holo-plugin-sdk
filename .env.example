# Infrastructure hosts are NOT set here.
# - Local dev (npm run api:dev): env.ts defaults to localhost
# - Docker Compose: docker-compose.yml defaults to container names (holokai-db, etc.)
# - Production: set explicitly in the deployment .env
#
# Only set infrastructure hosts if you need to override the defaults:
# AUDIT_PG_HOST=custom-db-host
# RABBITMQ_URL=amqp://custom-mq:5672
# REDIS_URL=redis://custom-redis:6379
# MOKU_URL=http://custom-moku:8080

# ── Docker ──────────────────────────────────────────
# Override these in deployed environments to pull pre-built images
# DOCKER_REGISTRY=671482219051.dkr.ecr.us-east-1.amazonaws.com/holokai/dev/holo
# IMAGE_TAG=1.2.1

# ── Server ──────────────────────────────────────────
PORT=3000
NODE_ENV=development
API_SERVER_ID=api
WORKER_ID=worker
AUDIT_ID=audit

# ── PostgreSQL ──────────────────────────────────────
AUDIT_PG_PORT=5432
AUDIT_PG_DATABASE=
AUDIT_PG_USER=
AUDIT_PG_PASSWORD=

# ── Auth ────────────────────────────────────────────
JWT_SECRET=

# ── Security ────────────────────────────────────────
# AES-256-GCM key for provider credential encryption (must match Moku)
# Generate with: npm run encrypt-key -- --generate-key
CREDENTIAL_ENCRYPTION_KEY=
