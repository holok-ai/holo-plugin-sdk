{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "lib": [
      "ESNext",
      "ESNext.Intl"
    ],
    "baseUrl": ".",
    "paths": {
      "@holokai/types": [
        "../types/src/index.ts"
      ],
      "@holokai/types/provider": [
        "../types/src/provider/index.ts"
      ],
      "@holokai/types/worker": [
        "../types/src/worker/index.ts"
      ],
      "@holokai/types/entities": [
        "../types/src/entities/index.ts"
      ],
      "@holokai/types/plugin": [
        "../types/src/plugin/index.ts"
      ],
      "@holokai/types/logger": [
        "../types/src/logger/index.ts"
      ],
      "@holokai/sdk": [
        "../sdk/src/index.ts"
      ],
      "@holokai/sdk/core": [
        "../sdk/src/core/index.ts"
      ],
      "@holokai/sdk/provider": [
        "../sdk/src/provider/index.ts"
      ],
      "@holokai/sdk/plugin": [
        "../sdk/src/plugin/index.ts"
      ],
      "@holokai/lib": [
        "../lib/src/index.ts"
      ],
      "@holokai/lib/pipeline": [
        "../lib/src/pipeline/index.ts"
      ]
    }
  },
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node",
    "compilerOptions": {
      "module": "ESNext",
      "moduleResolution": "node"
    },
    "transpileOnly": true,
    "files": false,
    "emit": false
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "tests/**/*"
  ],
  "references": [
    {
      "path": "../types"
    },
    {
      "path": "../sdk"
    },
    {
      "path": "../lib"
    }
  ]
}
