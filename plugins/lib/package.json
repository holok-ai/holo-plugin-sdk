{
  "name": "@holokai/lib",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Core pipeline functions for Holo — event processing, wire chunking, and HTTP writing",
  "author": "Holokai",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holok-ai/holo-lib.git"
  },
  "bugs": {
    "url": "https://github.com/holok-ai/holo-lib/issues"
  },
  "homepage": "https://github.com/holok-ai/holo-lib#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./pipeline": {
      "types": "./dist/pipeline/index.d.ts",
      "import": "./dist/pipeline/index.js",
      "require": "./dist/pipeline/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc --build",
    "build:watch": "tsc --build --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@holokai/types": "^1.3.0",
    "@holokai/sdk": "^1.3.0"
  },
  "peerDependencies": {
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "typescript": "^5.0.0"
  }
}
