{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ESNext", "ESNext.Intl"],
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "baseUrl": ".",
    "paths": {
      "@holokai/common": ["./packages/common/src/index.ts"],
      "@holokai/common/plugin": ["./packages/common/src/plugin/index.ts"],
      "@holokai/common/provider": ["./packages/common/src/provider/index.ts"],
      "@holokai/common/holo": ["./packages/common/src/holo/index.ts"],
      "@holokai/common/utils": ["./packages/common/src/utils/index.ts"]
    }
  },
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node",
    "compilerOptions": {
      "module": "ESNext",
      "moduleResolution": "node"
    },
    "transpileOnly": true,
    "files": false,
    "emit": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "packages", "tests"],
  "references": [
    { "path": "./packages/common" }
  ]
}
