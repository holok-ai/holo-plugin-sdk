generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model providers {
  id               String            @id @db.Uuid
  name             String            @unique @db.VarChar(255)
  description      String?
  config           Json              @default("{}")
  status           Json              @default("{\"enabled\": false, \"available\": false}")
  created_at       DateTime          @default(now()) @db.Timestamp(6)
  updated_at       DateTime          @default(now()) @db.Timestamp(6)
  created_by       String?           @db.VarChar(255)
  last_modified_by String?           @db.VarChar(255)
  models           provider_models[]
}

model models {
  id               String            @id @db.Uuid
  name             String            @db.VarChar(255)
  description      String?
  capabilities     Json              @default("{}")
  parameters       Json              @default("{}")
  metadata         Json              @default("{}")
  status           Json              @default("{\"enabled\": false, \"available\": false}")
  created_by       String?           @db.VarChar(255)
  created_at       DateTime          @default(now()) @db.Timestamp(6)
  last_modified_by String?           @db.VarChar(255)
  updated_at       DateTime          @default(now()) @db.Timestamp(6)
  providers        provider_models[]
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model provider_models {
  provider_id    String    @db.Uuid
  model_id       String    @db.Uuid
  config         Json      @default("{}")
  status         Json      @default("{\"enabled\": false, \"available\": false}")
  created_at     DateTime  @default(now()) @db.Timestamp(6)
  updated_at     DateTime  @default(now()) @db.Timestamp(6)
  active         Boolean   @default(true)
  last_active_at DateTime? @db.Timestamp(6)
  model          models    @relation(fields: [model_id], references: [id])
  provider       providers @relation(fields: [provider_id], references: [id])

  @@id([provider_id, model_id])
  @@index([provider_id])
  @@index([model_id])
}

model app_users {
  id                  String       @id @db.Uuid
  email               String       @unique @db.VarChar(255)
  display_name        String?      @db.VarChar(255)
  provider            String?      @db.VarChar(50)
  provider_id         String?      @db.VarChar(255)
  profile_picture_url String?      @db.VarChar(1024)
  created_at          DateTime?    @db.Timestamptz(6)
  last_login          DateTime?    @db.Timestamptz(6)
  active              Boolean?     @default(true)
  created_by          String?      @db.VarChar(255)
  last_modified_by    String?      @db.VarChar(255)
  updated_at          DateTime?    @db.Timestamptz(6)
  user_roles          user_roles[]
}

model app_users_audit {
  id                           String        @db.Uuid
  revision_id                  Int
  revision_type                Int           @db.SmallInt
  email                        String?       @db.VarChar(255)
  email_modified               Boolean?
  display_name                 String?       @db.VarChar(255)
  display_name_modified        Boolean?
  provider                     String?       @db.VarChar(50)
  provider_modified            Boolean?
  provider_id                  String?       @db.VarChar(255)
  provider_id_modified         Boolean?
  profile_picture_url          String?       @db.VarChar(1024)
  profile_picture_url_modified Boolean?
  created_at                   DateTime?     @db.Timestamptz(6)
  created_at_modified          Boolean?
  updated_at                   DateTime?     @db.Timestamptz(6)
  updated_at_modified          Boolean?
  active                       Boolean?
  active_modified              Boolean?
  created_by                   String?       @db.VarChar(255)
  created_by_modified          Boolean?
  last_modified_by             String?       @db.VarChar(255)
  last_modified_by_modified    Boolean?
  roles_modified               Boolean?
  revision_info                revision_info @relation(fields: [revision_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([id, revision_id])
  @@index([revision_id], map: "idx_app_users_audit_revision")
}

model flyway_schema_history {
  installed_rank Int      @id(map: "flyway_schema_history_pk")
  version        String?  @db.VarChar(50)
  description    String   @db.VarChar(200)
  type           String   @db.VarChar(20)
  script         String   @db.VarChar(1000)
  checksum       Int?
  installed_by   String   @db.VarChar(100)
  installed_on   DateTime @default(now()) @db.Timestamp(6)
  execution_time Int
  success        Boolean

  @@index([success], map: "flyway_schema_history_s_idx")
}

model llm_requests {
  id           String   @id @db.Uuid
  request_id   String   @db.VarChar(36)
  request_type String   @db.VarChar(50)
  model        String   @db.VarChar(100)
  prompt       String?
  options      Json?
  source_id    String?  @db.VarChar(100)
  user_id      String?  @db.VarChar(100)
  timestamp    DateTime @default(now()) @db.Timestamp(6)
  metadata     Json?
}

model llm_responses {
  id                String   @id @db.Uuid
  request_id        String   @db.VarChar(36)
  response_type     String   @db.VarChar(50)
  token             String?
  model             String?  @db.VarChar(100)
  worker_id         String?  @db.VarChar(100)
  timestamp         DateTime @default(now()) @db.Timestamp(6)
  is_final          Boolean? @default(false)
  total_tokens      Int?
  processing_time   Int?
  tokens_per_second Float?
  metadata          Json?

  @@index([request_id], map: "idx_response_request_id")
}

model models_audit {
  id                        String        @db.Uuid
  revision_id               Int
  revision_type             Int?          @db.SmallInt
  name                      String?       @db.VarChar(255)
  name_modified             Boolean?      @default(false)
  description               String?
  description_modified      Boolean?      @default(false)
  capabilities              Json?         @default("{}")
  capabilities_modified     Boolean?      @default(false)
  parameters                Json?         @default("{}")
  parameters_modified       Boolean?      @default(false)
  metadata                  Json?         @default("{}")
  metadata_modified         Boolean?      @default(false)
  status                    Json?         @default("{}")
  status_modified           Boolean?      @default(false)
  created_at                DateTime?     @db.Timestamp(6)
  created_at_modified       Boolean?      @default(false)
  updated_at                DateTime?     @db.Timestamp(6)
  updated_at_modified       Boolean?      @default(false)
  created_by                String?       @db.VarChar(255)
  created_by_modified       Boolean?
  last_modified_by          String?       @db.VarChar(255)
  last_modified_by_modified Boolean?
  providers_modified        Boolean?
  revision_info             revision_info @relation(fields: [revision_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([id, revision_id])
  @@index([id], map: "idx_models_audit_id")
  @@index([revision_id], map: "idx_models_audit_revision_id")
}

model oauth2_client_registration {
  id                           String    @id @db.Uuid
  registration_id              String    @unique @db.VarChar(100)
  client_id                    String    @db.VarChar(255)
  client_secret                String    @db.VarChar(255)
  client_name                  String?   @db.VarChar(255)
  client_authentication_method String?   @db.VarChar(100)
  authorization_grant_type     String?   @db.VarChar(100)
  redirect_uri                 String?   @db.VarChar(255)
  scopes                       String?
  client_settings              String?
  token_settings               String?
  enabled                      Boolean?  @default(true)
  created_at                   DateTime? @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime? @default(now()) @db.Timestamptz(6)
  created_by                   String?   @db.VarChar(255)
  last_modified_by             String?   @db.VarChar(255)
}

model oauth2_client_registration_audit {
  id                                    String        @db.Uuid
  revision_id                           Int
  revision_type                         Int           @db.SmallInt
  registration_id                       String?       @db.VarChar(100)
  registration_id_modified              Boolean?
  client_id                             String?       @db.VarChar(255)
  client_id_modified                    Boolean?
  client_secret                         String?       @db.VarChar(255)
  client_secret_modified                Boolean?
  client_name                           String?       @db.VarChar(255)
  client_name_modified                  Boolean?
  client_authentication_method          String?       @db.VarChar(100)
  client_authentication_method_modified Boolean?
  authorization_grant_type              String?       @db.VarChar(100)
  authorization_grant_type_modified     Boolean?
  redirect_uri                          String?       @db.VarChar(255)
  redirect_uri_modified                 Boolean?
  scopes                                String?
  scopes_modified                       Boolean?
  client_settings                       String?
  client_settings_modified              Boolean?
  token_settings                        String?
  token_settings_modified               Boolean?
  enabled                               Boolean?
  enabled_modified                      Boolean?
  created_at                            DateTime?     @db.Timestamptz(6)
  created_at_modified                   Boolean?
  updated_at                            DateTime?     @db.Timestamptz(6)
  updated_at_modified                   Boolean?
  created_by                            String?       @db.VarChar(255)
  created_by_modified                   Boolean?
  last_modified_by                      String?       @db.VarChar(255)
  last_modified_by_modified             Boolean?
  revision_info                         revision_info @relation(fields: [revision_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([id, revision_id])
  @@index([revision_id], map: "idx_oauth2_client_audit_revision")
}

model oauth2_provider {
  id                              String    @id @db.Uuid
  provider_id                     String    @unique @db.VarChar(100)
  authorization_uri               String?   @db.VarChar(255)
  token_uri                       String?   @db.VarChar(255)
  jwk_set_uri                     String?   @db.VarChar(255)
  user_info_uri                   String?   @db.VarChar(255)
  user_info_authentication_method String?   @db.VarChar(100)
  user_name_attribute             String?   @db.VarChar(100)
  configuration_metadata          String?
  created_at                      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at                      DateTime? @default(now()) @db.Timestamptz(6)
  created_by                      String?   @db.VarChar(255)
  last_modified_by                String?   @db.VarChar(255)
}

model oauth2_provider_audit {
  id                                       String        @db.Uuid
  revision_id                              Int
  revision_type                            Int           @db.SmallInt
  provider_id                              String?       @db.VarChar(100)
  provider_id_modified                     Boolean?
  authorization_uri                        String?       @db.VarChar(255)
  authorization_uri_modified               Boolean?
  token_uri                                String?       @db.VarChar(255)
  token_uri_modified                       Boolean?
  jwk_set_uri                              String?       @db.VarChar(255)
  jwk_set_uri_modified                     Boolean?
  user_info_uri                            String?       @db.VarChar(255)
  user_info_uri_modified                   Boolean?
  user_info_authentication_method          String?       @db.VarChar(100)
  user_info_authentication_method_modified Boolean?
  user_name_attribute                      String?       @db.VarChar(100)
  user_name_attribute_modified             Boolean?
  configuration_metadata                   String?
  configuration_metadata_modified          Boolean?
  created_at                               DateTime?     @db.Timestamptz(6)
  created_at_modified                      Boolean?
  updated_at                               DateTime?     @db.Timestamptz(6)
  updated_at_modified                      Boolean?
  created_by                               String?       @db.VarChar(255)
  created_by_modified                      Boolean?
  last_modified_by                         String?       @db.VarChar(255)
  last_modified_by_modified                Boolean?
  revision_info                            revision_info @relation(fields: [revision_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([id, revision_id])
  @@index([revision_id], map: "idx_oauth2_provider_audit_revision")
}

model prompts {
  id                String   @id @db.Uuid
  name              String
  description       String?
  provider          String
  prompt_type       String
  system_prompt     String?
  user_prompt       String
  parameters        Json     @default("{}")
  temperature       Float?
  top_p             Float?
  top_k             Int?
  max_tokens        Int?
  presence_penalty  Float?
  frequency_penalty Float?
  stop_sequences    String[] @default([])
  model             String?
  anthropic_version String?
  safety_settings   Json?
  grok_settings     Json?
  tags              String[] @default([])
  version           String   @default("1.0")
  is_active         Boolean  @default(true)
  created_by        String?
  updated_by        String?
  created_at        DateTime @default(now())
  updated_at        DateTime

  @@index([name])
  @@index([provider, prompt_type])
  @@index([tags])
}

model provider_models_audit {
  revision_id   Int
  revision_type Int           @db.SmallInt
  provider_id   String        @db.Uuid
  model_id      String        @db.Uuid
  revision_info revision_info @relation(fields: [revision_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([revision_id, provider_id, model_id])
  @@index([model_id], map: "idx_provider_models_audit_model")
  @@index([provider_id], map: "idx_provider_models_audit_provider")
  @@index([revision_id], map: "idx_provider_models_audit_revision")
}

model providers_audit {
  id                        String        @db.Uuid
  revision_id               Int
  revision_type             Int           @db.SmallInt
  name                      String?       @db.VarChar(255)
  name_modified             Boolean?
  description               String?
  description_modified      Boolean?
  config                    Json?
  config_modified           Boolean?
  status                    Json?
  status_modified           Boolean?
  created_at                DateTime?     @db.Timestamp(6)
  created_at_modified       Boolean?
  updated_at                DateTime?     @db.Timestamp(6)
  updated_at_modified       Boolean?
  created_by                String?       @db.VarChar(255)
  created_by_modified       Boolean?
  last_modified_by          String?       @db.VarChar(255)
  last_modified_by_modified Boolean?
  models_modified           Boolean?
  revision_info             revision_info @relation(fields: [revision_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([id, revision_id])
  @@index([id], map: "idx_providers_audit_id")
  @@index([revision_id], map: "idx_providers_audit_revision")
}

model revision_info {
  id                               Int                                @id @default(autoincrement())
  timestamp                        BigInt
  username                         String?                            @db.VarChar(255)
  ip_address                       String?                            @db.VarChar(45)
  user_agent                       String?                            @db.VarChar(1000)
  metadata                         String?
  app_users_audit                  app_users_audit[]
  models_audit                     models_audit[]
  oauth2_client_registration_audit oauth2_client_registration_audit[]
  oauth2_provider_audit            oauth2_provider_audit[]
  provider_models_audit            provider_models_audit[]
  providers_audit                  providers_audit[]
  revision_info_changed_entities   revision_info_changed_entities[]
  user_roles_audit                 user_roles_audit[]

  @@index([timestamp], map: "idx_revision_info_timestamp")
  @@index([username], map: "idx_revision_info_username")
}

model revision_info_changed_entities {
  revision_info_id Int
  entity_name      String        @db.VarChar(255)
  revision_info    revision_info @relation(fields: [revision_info_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([revision_info_id, entity_name])
  @@index([revision_info_id], map: "idx_revision_info_changed_entities_revision_id")
}

model user_roles {
  user_id   String    @db.Uuid
  roles     String    @db.VarChar(50)
  app_users app_users @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, roles])
}

model user_roles_audit {
  revision_id   Int
  revision_type Int           @db.SmallInt
  user_id       String        @db.Uuid
  roles         String        @db.VarChar(50)
  revision_info revision_info @relation(fields: [revision_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([revision_id, user_id, roles])
}
