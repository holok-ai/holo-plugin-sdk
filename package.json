{
  "name": "holokai",
  "version": "1.0.0",
  "private": true,
  "description": "Holokai monorepo",
  "type": "module",
  "workspaces": [
    "app",
    "plugins/*"
  ],
  "scripts": {
    "prepare": "husky",
    "start": "cd app && npm run start",
    "start-worker": "cd app && npm run start-worker",
    "start-audit": "cd app && npm run start-audit",
    "start-analysis": "cd app && npm run start-analysis",
    "dev": "cd app && npm run dev",
    "api:dev": "cd app && npm run api:dev",
    "worker:dev": "cd app && npm run worker:dev",
    "audit:dev": "cd app && npm run audit:dev",
    "analysis:dev": "cd app && npm run analysis:dev",
    "build:workspaces": "npm run build --workspaces --if-present",
    "clean:workspaces": "npm run clean --workspaces --if-present",
    "test:workspaces": "npm run test --workspaces --if-present",
    "type-check": "npm run build:workspaces && tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "validate:boundaries": "node app/scripts/validate-boundaries.js",
    "validate:plugin-boundaries": "bash app/scripts/validate-plugin-boundaries.sh",
    "docs:serve": "npx http-server ./docs -p 3001",
    "docs:check": "ls -la README.md CONTRIBUTING.md plugins/*/README.md",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release": "npm run build:workspaces && changeset publish",
    "pack:sdk": "cd plugins/sdk && npm pack",
    "pack:all": "npm run pack:sdk && cd plugins/holo-provider-claude && npm pack && cd ../holo-provider-openai && npm pack && cd ../holo-provider-ollama && npm pack"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.3",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.5.2",
    "prettier": "^3.6.2",
    "prisma": "^6.14.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
