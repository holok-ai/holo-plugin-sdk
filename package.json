{
  "name": "holo",
  "version": "1.0.0",
  "private": true,
  "description": "Holokai Holo",
  "type": "module",
  "main": "src/app.js",
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "prepare": "husky",
    "start": "node --import ./scripts/register-ts-node.mjs src/app.ts",
    "start-worker": "node --import ./scripts/register-ts-node.mjs src/servers/worker.server.ts",
    "start-audit": "node --import ./scripts/register-ts-node.mjs src/servers/audit.server.ts",
    "start-analysis": "node --import ./scripts/register-ts-node.mjs src/servers/analysis.server.ts",
    "dev": "nodemon src/app.js",
    "api:dev": "nodemon --exec \"node --import ./scripts/register-ts-node.mjs\" src/app.ts",
    "worker:dev": "nodemon --exec \"node --import ./scripts/register-ts-node.mjs\" src/servers/worker.server.ts",
    "audit:dev": "nodemon --exec \"node --import ./scripts/register-ts-node.mjs\" src/servers/audit.server.ts",
    "analysis:dev": "nodemon --exec \"node --import ./scripts/register-ts-node.mjs\" src/servers/analysis.server.ts",
    "test": "jest --config=./jest.config.cjs",
    "test:unit": "jest --config=./jest.config.cjs tests/unit --testTimeout=10000",
    "test:integration": "jest --config=./jest.config.cjs tests/integration --testTimeout=30000 --runInBand",
    "test:workspaces": "npm run test --workspaces --if-present",
    "test:baseline": "jest --config=./jest.config.cjs tests/baseline --testTimeout=30000",
    "test:monorepo": "jest tests/baseline/monorepo --testTimeout=10000",
    "test:boundaries": "jest tests/baseline/boundaries --testTimeout=10000",
    "test:build": "jest tests/baseline/build --testTimeout=15000",
    "test:performance": "jest tests/baseline/performance --testTimeout=30000",
    "test:plugin": "jest tests/baseline/integration --testTimeout=15000",
    "build": "tsc --build",
    "build:plugins": "npm run build --workspaces --if-present",
    "build:workspaces": "npm run build --workspaces --if-present",
    "clean": "tsc --build --clean",
    "clean:workspaces": "npm run clean --workspaces --if-present",
    "type-check": "npm run build:plugins && tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "validate:boundaries": "node scripts/validate-boundaries.js",
    "docs:serve": "npx http-server ./docs -p 3001",
    "docs:check": "ls -la README.md CONTRIBUTING.md plugins/*/README.md"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.1",
    "@prisma/client": "^6.14.0",
    "amqplib": "^0.10.9",
    "arktype": "^2.1.22",
    "azure-devops-node-api": "^15.1.1",
    "body-parser": "^1.20.2",
    "diff": "^8.0.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-jwt": "^8.5.1",
    "express-list-endpoints": "^7.1.1",
    "fs-extra": "^11.3.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cache": "^5.1.2",
    "ollama": "^0.6.3",
    "openai": "^6.9.1",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "uuid": "^9.0.1",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.3",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@types/amqplib": "^0.10.7",
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.3",
    "@types/express-list-endpoints": "^6.0.3",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.0.11",
    "@types/node-cache": "^4.1.3",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.2",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "prisma": "^6.14.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
