{
  "name": "llm-proxy",
  "version": "1.0.0",
  "description": "LLM Proxy Server with RabbitMQ for distributed processing",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "api:dev": "nodemon --watch src --exec ts-node src/app.ts",
    "worker:dev": "nodemon --watch src --exec ts-node src/servers/worker.server.ts",
    "audit:dev": "nodemon --watch src --exec ts-node src/servers/audit.server.ts",
    "analysis:dev": "nodemon --watch src --exec ts-node src/servers/analysis.server.ts",
    "test": "jest",
    "build": "tsc",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.57.0",
    "@prisma/client": "^6.14.0",
    "amqplib": "^0.10.3",
    "azure-devops-node-api": "^15.1.1",
    "body-parser": "^1.20.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-jwt": "^8.5.1",
    "express-list-endpoints": "^7.1.1",
    "fs-extra": "^11.3.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "ollama": "^0.5.15",
    "openai": "^5.11.0",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/express": "^5.0.3",
    "@types/express-list-endpoints": "^6.0.3",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.0.11",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "eslint": "^9.30.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prisma": "^6.14.0",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ]
  },
  "license": "MIT"
}
