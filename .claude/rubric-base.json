{
  "base_version": "1.0",
  "default_dimensions": [
    {
      "key": "correctness",
      "weight": 0.35,
      "max": 5,
      "description": "Code produces correct output for all inputs, handles edge cases"
    },
    {
      "key": "completeness",
      "weight": 0.25,
      "max": 5,
      "description": "All requirements implemented, no missing features"
    },
    {
      "key": "clarity",
      "weight": 0.15,
      "max": 5,
      "description": "Code is readable, well-named, properly structured"
    },
    {
      "key": "quality",
      "weight": 0.15,
      "max": 5,
      "description": "Follows conventions, maintainable, tested with FUNCTIONAL tests (no mocks)"
    },
    {
      "key": "safety",
      "weight": 0.1,
      "max": 5,
      "description": "Secure, no vulnerabilities, proper error handling"
    }
  ],
  "defaults": {
    "pass_threshold": 4,
    "stop_conditions": {
      "max_iterations": 3,
      "critical_blocks": [
        "security_violation",
        "spec_mismatch",
        "mock_tests_detected",
        "code_in_ai_docs",
        "missing_architecture_diagrams"
      ]
    }
  },
  "test_quality_rules": {
    "reject_patterns": [
      "jest.mock(",
      ".mockReturnValue(",
      ".mockImplementation(",
      "mock[A-Z]\\w+\\(",
      "expect\\(mock\\w+\\).toHaveBeenCalled"
    ],
    "require_patterns": [
      "Tests must verify actual behavior with real inputs/outputs",
      "Tests must use real filesystem, real I/O, real dependencies",
      "Tests must verify security properties (path traversal, injection, validation)",
      "Tests must verify edge cases with actual data",
      "No tests that just verify third-party libraries work"
    ],
    "scoring": {
      "mock_test_penalty": -5,
      "functional_test_bonus": 2,
      "security_test_bonus": 3,
      "integration_test_bonus": 2
    }
  },
  "documentation_quality_rules": {
    "ai_documentation": {
      "paths": [
        ".claude/",
        "CLAUDE.md"
      ],
      "reject_patterns": [
        "```typescript",
        "```javascript",
        "```python",
        "```java",
        "```go",
        "// Example:",
        "# Example:"
      ],
      "require_patterns": [
        "Purpose-built prompts and instructions",
        "Clear decision criteria (when to use X vs Y)",
        "Constraints and rules",
        "Design rationale (why, not how)",
        "NO code examples or implementation details"
      ],
      "scoring": {
        "code_example_penalty": -5,
        "clear_prompt_bonus": 2,
        "decision_criteria_bonus": 3
      }
    },
    "user_documentation": {
      "paths": [
        "docs/",
        "README.md",
        "ARCHITECTURE.md"
      ],
      "reject_patterns": [
        "```typescript",
        "```javascript",
        "Step 1:",
        "First, do this:",
        "Here's how to"
      ],
      "require_patterns": [
        "Architecture diagrams (ASCII or Mermaid)",
        "Design decision rationale",
        "Component relationships visualized",
        "Trade-offs documented",
        "NO code examples or tutorials"
      ],
      "scoring": {
        "code_example_penalty": -5,
        "tutorial_content_penalty": -3,
        "architecture_diagram_bonus": 4,
        "design_rationale_bonus": 3
      }
    }
  },
  "_warning": "⚠️  AUTO-GENERATED FILE - DO NOT EDIT DIRECTLY! Edit source in templates/ or src/, then run: npm run build"
}