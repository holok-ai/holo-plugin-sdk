{
  "typescript": {
    "formatter": [
      {
        "name": "prettier",
        "check": "npx prettier --version",
        "install": "npm install -D prettier",
        "config": ".prettierrc",
        "priority": 1
      },
      {
        "name": "biome",
        "check": "npx @biomejs/biome --version",
        "install": "npm install -D @biomejs/biome",
        "config": "biome.json",
        "priority": 2
      }
