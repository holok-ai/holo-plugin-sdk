{
  "$id": "https://example.com/schemas/rubric.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rubric",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rubric_id",
    "task_id",
    "version",
    "dimensions",
    "task_checks",
    "pass_threshold",
    "stop_conditions"
  ],
  "properties": {
    "rubric_id": { "type": "string", "minLength": 8, "maxLength": 96 },
    "task_id": { "type": "string", "minLength": 8, "maxLength": 64 },
    "version": { "type": "string", "minLength": 1 },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "weight", "max"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "max": { "type": "integer", "enum": [5] }
        }
      }
    },
    "task_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["must_pass_all"],
      "properties": {
        "must_pass_all": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "description"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 }
            }
          }
        },
        "nice_to_have": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "pass_threshold": { "type": "number", "minimum": 0, "maximum": 5, "default": 4.0 },
    "stop_conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_iterations"],
      "properties": {
        "max_iterations": { "type": "integer", "minimum": 1, "maximum": 10, "default": 3 },
        "critical_blocks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        }
      }
    },
    "metadata": { "type": "object" }
  }
}
