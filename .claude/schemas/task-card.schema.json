{
  "$id": "https://example.com/schemas/task-card.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task Card",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "name", "artifact_type", "success_criteria", "hard_requirements", "status"],
  "properties": {
    "task_id": { "type": "string", "minLength": 8, "maxLength": 64 },
    "name": { "type": "string", "minLength": 1 },
    "artifact_type": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["new", "plan_approved", "in_progress", "done"]
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "hard_requirements": {
      "type": "array",
      "minItems": 0,
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "description"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    },
    "weight_overrides": {
      "description": "Optional per-task weight overrides by dimension key",
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "metadata": { "type": "object" }
  }
}
